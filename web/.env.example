# Copy to web/.env.local
# API origin; leave empty to use the Vite dev proxy / same origin.
VITE_API_URL=
# Shows the "dev login" form outside Telegram. Must match Z2_DEV_LOGIN on the backend.
VITE_DEV_LOGIN=true
# Bot username (without @) for the Telegram Login Widget and t.me invite links.
VITE_TELEGRAM_BOT_USERNAME=
# Mini App short name registered with BotFather (/newapp), used in t.me/<bot>/<app>?startapp=... links.
VITE_TELEGRAM_APP_SHORT_NAME=
