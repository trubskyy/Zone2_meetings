# Copy to backend/.env. All settings are documented in app/config.py.
Z2_DATABASE_URL=sqlite:///./zone2.db
Z2_TELEGRAM_BOT_TOKEN=
Z2_JWT_SECRET=change-me-to-a-long-random-string
Z2_DEV_LOGIN=true
# Must be HTTPS for Telegram (use a tunnel such as cloudflared or ngrok in development).
Z2_WEB_APP_URL=http://localhost:5173
Z2_CORS_ORIGINS=["http://localhost:5173"]
# Production only (set by the Dockerfile): serve web/dist from the API, and run the bot in-process.
# Z2_STATIC_DIR=../web/dist
# Z2_RUN_BOT=true
